# Copy this file to `.env.test` (gitignored) and fill it in.
#
# These variables are used ONLY by the authenticated tests:
#   - src/lib/rls-auth.test.ts   (API-level: reader blind vs chief unblinded)
#   - e2e/authenticated.spec.ts  (browser: reader blocked vs chief sees dashboard)
#
# Leave everything blank (or omit the file) and those suites are skipped.
#
# Recommended: point at a SEPARATE throwaway Supabase project so the tests
# never touch the real journal data. If you omit TEST_SUPABASE_URL/KEY, the
# tests fall back to the app's own VITE_SUPABASE_* project.
#
# The two accounts must already exist in that project's `members` table, and
# one must be a chief_editor. Email confirmation must be off (or the accounts
# confirmed) so password sign-in works.

TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=

TEST_READER_EMAIL=
TEST_READER_PASSWORD=

TEST_CHIEF_EMAIL=
TEST_CHIEF_PASSWORD=
