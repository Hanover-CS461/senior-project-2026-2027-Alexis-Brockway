# Production build settings for the GitHub Pages deploy.
#
# These values are public by design: Vite inlines every VITE_* variable into the
# JavaScript bundle, and the publishable key grants nothing on its own — RLS is
# what protects the data. Committing them is what lets the Pages workflow build
# with no repository secrets, and lets a fresh clone run immediately.
#
# Never put SUPABASE_SERVICE_ROLE_KEY (or any sb_secret_* key) in this file.
VITE_SUPABASE_URL=https://qsynlsbltpnhzncpqerz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Zyc4ENIuJ5L1hFjAxvbg5g_5jdXNPz_
